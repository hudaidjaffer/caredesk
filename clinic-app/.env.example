# CareDesk settings. Copy this file to ".env" (in this same clinic-app folder) and fill in your values.
# The owner panel reads this same file. NEVER share .env or put it in a public place:
# it contains your database password and Supabase secret key.

# ---- Supabase database (required) ---------------------------------------------------------
# Supabase dashboard -> your project -> "Connect" button -> pick ONE of:
#   * "Direct connection"   postgresql://postgres:YOUR-PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
#       (needs IPv6; most home/office internet has it)
#   * "Session pooler"      postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#       (works everywhere, IPv4)
# Do NOT use the "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password (Project Settings -> Database -> reset it if you forgot).
DATABASE_URL=

# Optional: verify Supabase's certificate. Download "SSL certificate" from Project Settings -> Database,
# save it next to this file, and put its file name here (e.g. prod-ca-2021.crt).
DATABASE_CA_CERT=

# Optional: the database schema the tables are created in (default: caredesk).
# DB_SCHEMA=caredesk

# ---- Supabase Storage for uploaded photos/PDFs and backups (recommended) ---------------------
# Project Settings -> API Keys -> "Secret keys" (sb_secret_...)  (or the legacy "service_role" key).
# NEVER use the publishable/anon key here, and never put the secret key in any web page.
# Leave both empty to keep uploaded files on this computer instead.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=caredesk-files

# ---- Encryption key (optional) ---------------------------------------------------------------
# By default the key is created in data/secret.key. On a hosting service, put it here instead
# (copy it from the owner panel -> Security & backups -> Show recovery key).
# Keep it OUT of Supabase: that's what keeps medical data unreadable even if the database leaks.
# CAREDESK_KEY=

# ---- Server (optional) -------------------------------------------------------------------------
# PORT=3000
# OWNER_PORT=4000
# SECURE_COOKIES=1        # set when served over HTTPS
# TRUST_PROXY=1           # set when behind ngrok / a tunnel / nginx, so sign-in limits and the audit log see each visitor's real IP
